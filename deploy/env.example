# Browser-bridge production environment — SDD v0.5 §25.
# Copy to deploy/.env, replace the CHANGE_ME lines, chmod 0600. Never commit
# the real file. Everything else below is prefilled for the fluxlab
# deployment (VPS behind the existing fluxology-caddy) and was verified
# live on 2026-08-31:
#   curl -fsS https://auth.fluxology.ca/realms/fluxology/.well-known/openid-configuration
#
# REDEPLOYING over a stack that is already running? Recover the secrets from
# the live gateway container instead of minting new ones — the postgres
# volume keeps its old password, and audit F-19 wants ARTIFACT_URL_SECRET
# stable across restarts so signed artifact URLs stay valid:
#   docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' \
#     $(docker ps -qf name=mcp-gateway) \
#     | grep -E '^(DATABASE_URL|ARTIFACT_URL_SECRET|POSTGRES_PASSWORD|[A-Z]+_INGEST_TOKEN)='

# ---- Gateway ----
NODE_ENV=production
# Canonical public origin: what claude.ai attaches to and what artifact URLs
# are minted against. The Windows agent connects to the same host:
#   wss://browser-mcp.fluxlab.systems/agent/ws
PUBLIC_BASE_URL=https://browser-mcp.fluxlab.systems
PORT=3000
# The legacy hostname still routes through the same Caddy to this gateway;
# accept its Host header so existing clients keep working.
EXTRA_ALLOWED_HOSTS=browser-mcp.fluxology.ca

# PostgreSQL connection for the gateway (backend network hostname). The
# password must equal POSTGRES_PASSWORD below — and on a redeploy it must be
# the OLD password: the postgres volume was initialized with it, and the
# bootstrap variables have no effect on an existing data directory.
DATABASE_URL=postgres://bridge:CHANGE_ME_DB_PASSWORD@postgres:5432/browser_bridge

# ---- OAuth 2.1 resource server (required in production, §10) ----
# Keycloak realm `fluxology` from deploy/auth/, still served at
# auth.fluxology.ca (auth.fluxlab.systems is not wired to the realm).
# OAUTH_AUDIENCE must equal the audience the realm's mappers mint
# (deploy/auth/realm-fluxology.json, included.custom.audience) — that value
# predates the fluxlab hostname and still says browser-mcp.fluxology.ca/mcp.
# If the realm is ever re-pointed at fluxlab, change the mapper and this
# line together.
OAUTH_MODE=required
OAUTH_ISSUER=https://auth.fluxology.ca/realms/fluxology
OAUTH_AUDIENCE=https://browser-mcp.fluxology.ca/mcp
OAUTH_JWKS_URI=https://auth.fluxology.ca/realms/fluxology/protocol/openid-connect/certs

# ---- Artifacts (§16) ----
ARTIFACT_DIR=/var/lib/browser-bridge/artifacts
ARTIFACT_TTL_SECONDS=900
# >=16 chars. Redeploy: reuse the previous value (recovery command above).
# Fresh install: openssl rand -base64 32
ARTIFACT_URL_SECRET=CHANGE_ME_ARTIFACT_URL_SECRET

# ---- Device channel ----
DEVICE_HEARTBEAT_SECONDS=20

# ---- Rate limits (0 disables) ----
RATE_LIMIT_MCP_PER_MINUTE=120
RATE_LIMIT_PAIR_PER_MINUTE=10

# ---- Site profiles ----
EBAY_DESTINATION_POSTAL_CODE=M6H 2W9

# ---- Fluxology dashboard write-path (dashboard.feed / dashboard.upsert) ----
# The gateway shares the fluxology-edge network with the dashboard API, so
# the internal container address works; leaving these unset disables the
# tools. Tokens are the same values the dashboard-api stack holds (built
# from the fluxlab-boards repo) — they live HERE, in the gateway env, never
# in task text or tool output. On a redeploy the recovery command above
# prints all five.
DASHBOARD_API_BASE_URL=http://fluxology-dashboard-api:8082
DEALS_INGEST_TOKEN=CHANGE_ME_DEALS_INGEST_TOKEN
OFFICE_INGEST_TOKEN=CHANGE_ME_OFFICE_INGEST_TOKEN
JOBS_INGEST_TOKEN=CHANGE_ME_JOBS_INGEST_TOKEN
VACATION_INGEST_TOKEN=CHANGE_ME_VACATION_INGEST_TOKEN
WARDROBE_INGEST_TOKEN=CHANGE_ME_WARDROBE_INGEST_TOKEN

LOG_LEVEL=info

# ---- postgres container bootstrap (postgres:17-alpine) ----
# Applied only on the FIRST boot of an empty deploy_postgres-data volume; an
# existing volume keeps whatever password it was created with (see the
# redeploy note on DATABASE_URL).
POSTGRES_USER=bridge
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=browser_bridge

# =====================================================================
# Windows agent (set on the Windows PC, not on the VPS):
#   AGENT_GATEWAY_URL=wss://browser-mcp.fluxlab.systems/agent/ws
#     (install-logon-task.ps1 -GatewayUrl persists this for the logon task)
#   AGENT_PROFILE_DIR=%LOCALAPPDATA%\Fluxology\BrowserBridge\profiles\ebay-research
#   AGENT_SITE_PROFILES=ebay.ca.v1,kijiji.ca.v1,zazzle.com.v1   (default)
#   AGENT_UI_GLYPHS=auto        (console dashboard glyphs; force unicode/ascii)
#   AGENT_TASK_NAME=FluxologyBrowserBridgeAgent   (only if -TaskName changed)
# =====================================================================

# Browser-bridge production environment — SDD v0.5 §25.
# Copy to deploy/.env, replace the CHANGE_ME values, chmod 0600. Never
# commit the real file. The OAuth endpoints were verified live on
# 2026-08-31:
#   curl -fsS https://auth.fluxlab.systems/realms/fluxlab/.well-known/openid-configuration
#
# NOTE — this file backs deploy/compose.yaml, the original fluxology-VPS
# deployment path. The fluxlab VPS does not use it: there the bridge is
# deployed by the FluxLab repo's vps/bridge/deploy.sh, which maintains the
# mcp-ebay checkout under SRC_ROOT and generates its own .env with these
# same variables (identical OAuth values).
#
# The previous stack (browser-mcp.fluxology.ca) still runs on the old VPS;
# its gateway container env holds the old secrets if anything needs to be
# carried over:
#   docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' \
#     $(docker ps -qf name=mcp-gateway) | grep -E '^(ARTIFACT_URL_SECRET|[A-Z]+_INGEST_TOKEN)='

# ---- Gateway ----
NODE_ENV=production
# Canonical public origin: what claude.ai attaches to and what artifact
# URLs are minted against. The Windows agent connects to the same host:
#   wss://browser-mcp.fluxlab.systems/agent/ws
PUBLIC_BASE_URL=https://browser-mcp.fluxlab.systems
PORT=3000
# Accept the legacy hostname's Host header during the migration window.
EXTRA_ALLOWED_HOSTS=browser-mcp.fluxology.ca

# PostgreSQL connection for the gateway (backend network hostname). The
# password must equal POSTGRES_PASSWORD below; both apply to the postgres
# volume on FIRST boot only, so pick it before the first `up`.
DATABASE_URL=postgres://bridge:CHANGE_ME_DB_PASSWORD@postgres:5432/browser_bridge

# ---- OAuth 2.1 resource server (required in production, §10) ----
# Keycloak realm `fluxlab` at auth.fluxlab.systems (issuer + JWKS verified
# live; the legacy realm remains at
# https://auth.fluxology.ca/realms/fluxology if a rollback is ever needed).
# OAUTH_AUDIENCE must equal the audience the fluxlab realm's mappers mint
# for the bridge clients — mirror of the old realm's
# included.custom.audience pattern. If MCP calls fail 401 with a valid
# token, compare this line against the `aud` claim in an access token
# (or the client scope's audience mapper in the admin console).
OAUTH_MODE=required
OAUTH_ISSUER=https://auth.fluxlab.systems/realms/fluxlab
OAUTH_AUDIENCE=https://browser-mcp.fluxlab.systems/mcp
OAUTH_JWKS_URI=https://auth.fluxlab.systems/realms/fluxlab/protocol/openid-connect/certs

# ---- Artifacts (§16) ----
ARTIFACT_DIR=/var/lib/browser-bridge/artifacts
ARTIFACT_TTL_SECONDS=900
# >=16 chars; keep it stable across restarts (audit F-19: signed artifact
# URLs must survive a redeploy). Generate: openssl rand -base64 32
ARTIFACT_URL_SECRET=CHANGE_ME_ARTIFACT_URL_SECRET

# ---- Device channel ----
DEVICE_HEARTBEAT_SECONDS=20

# ---- Rate limits (0 disables) ----
RATE_LIMIT_MCP_PER_MINUTE=120
RATE_LIMIT_PAIR_PER_MINUTE=10

# ---- Site profiles ----
EBAY_DESTINATION_POSTAL_CODE=M6H 2W9

# ---- eBay API source (Countdown API) ----
# Traject Data's eBay scraping API (api.countdownapi.com) behind the
# gateway-served ebay_api_search / ebay_api_items / ebay_api_seller tools
# the deals routine uses for its Track A sweeps, and the credit-free
# ebay_api_status budget probe it calls first. Leaving the key EMPTY
# disables the tools (the gateway reads an empty value as unset), and the
# line is blank rather than a CHANGE_ME placeholder on purpose: FluxLab's
# deploy script copies it verbatim into an existing .env and refuses
# placeholders. Paste the key from app.countdownapi.com. It lives HERE, in
# the gateway env, never in task text, tool output or git.
COUNTDOWN_API_KEY=
# COUNTDOWN_ROLE: how the source is offered to a run. Blank or "secondary"
# (the default, and the operator's standing instruction of 2026-09-03
# until they say otherwise) registers the tools but admits a charged
# ebay_api_search / ebay_api_items / ebay_api_seller call ONLY when it
# declares a fallbackReason naming why the Browser Bridge could not do
# that step; an undeclared call is refused with SOURCE_REJECTED
# (details.reason secondary_role) at no cost. "primary" restores the
# credit-gate-only admission; "off" registers no ebay_api_* tools at all
# while the key stays in place for a later flip. ebay_api_status reports
# role.name, so a deploy is verifiable from a Claude session.
COUNTDOWN_ROLE=
# The gateway only ever sends two customer_zipcode values to the vendor:
# EBAY_DESTINATION_POSTAL_CODE above (uppercased, no space) and this one,
# the MyUS Sarasota suite from the boards' multi-path shipping policy.
EBAY_FORWARDER_ZIPCODE=34249
# Optional tuning; the values shown are the defaults the gateway applies
# when a line is absent or blank. COUNTDOWN_API_BASE_URL exists for the
# integration stub only.
# COUNTDOWN_CREDIT_RESERVE: the credits the gateway holds back. Either a
# percentage of the plan's credit limit ("5%", an integer 0-50%, resolved
# from the vendor's free account endpoint: 5 on the 100-request trial, 25
# on Hobbyist, 500 on Starter) or an absolute count ("500"). Search and
# item calls are refused with SOURCE_CREDITS_EXHAUSTED once fewer credits
# remain; seller lookups still run. An absolute value at or above the
# plan's limit can never be satisfied and is refused as such (the first
# fire on the trial was: 500 against a one-time 100), so prefer the
# percentage. ebay_api_status reports the resolved figure and the budget.
# COUNTDOWN_MAX_CONCURRENCY: parallel item-page requests inside one
# ebay_api_items call (1-8).
# COUNTDOWN_TIMEOUT_MS: per vendor request (5000-48000). The MCP client
# allows a tool 60 s and the search/items tools answer inside 50 s, so a
# request must time out on its own first; 48000 is that deadline less 2 s.
# COUNTDOWN_API_BASE_URL=https://api.countdownapi.com
# COUNTDOWN_CREDIT_RESERVE=5%
# COUNTDOWN_MAX_CONCURRENCY=4
# COUNTDOWN_TIMEOUT_MS=45000
# GATEWAY_BUILD_SHA: the commit the gateway image was built from, reported
# by ebay_api_status as build.gateway. The image sets it at build time; do
# NOT add an active line here (an env_file value, even a blank one, would
# override the image's), and an image built without it reads "unknown".

# ---- Fluxology dashboard write-path (dashboard.feed / dashboard.upsert) ----
# The gateway shares the edge network with the dashboard API, so the
# internal container address works; leaving these unset disables the
# tools. Confirm the container name on THIS host (docker ps) — the value
# below is the historical one. Tokens are the same values the
# dashboard-api stack holds (fluxlab-boards repo) — copy them from that
# stack's .env; they live HERE, in the gateway env, never in task text or
# tool output.
DASHBOARD_API_BASE_URL=http://fluxology-dashboard-api:8082
DEALS_INGEST_TOKEN=CHANGE_ME_DEALS_INGEST_TOKEN
OFFICE_INGEST_TOKEN=CHANGE_ME_OFFICE_INGEST_TOKEN
JOBS_INGEST_TOKEN=CHANGE_ME_JOBS_INGEST_TOKEN
VACATION_INGEST_TOKEN=CHANGE_ME_VACATION_INGEST_TOKEN
WARDROBE_INGEST_TOKEN=CHANGE_ME_WARDROBE_INGEST_TOKEN

LOG_LEVEL=info

# ---- postgres container bootstrap (postgres:17-alpine) ----
# Applied only on the FIRST boot of an empty postgres-data volume; an
# existing volume keeps whatever password it was created with.
POSTGRES_USER=bridge
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=browser_bridge

# =====================================================================
# Windows agent (set on the Windows PC, not on the VPS):
#   AGENT_GATEWAY_URL=wss://browser-mcp.fluxlab.systems/agent/ws
#     (install-logon-task.ps1 -GatewayUrl persists this for the logon task)
#   AGENT_PROFILE_DIR=%LOCALAPPDATA%\Fluxology\BrowserBridge\profiles\ebay-research
#   AGENT_SITE_PROFILES=ebay.ca.v1,kijiji.ca.v1,zazzle.com.v1,wardrobe-vendors.v1   (default)
#   (wardrobe-vendors.v1 is the policy-only roster of non-Zazzle apparel vendors;
#    an agent .env that pins this list explicitly must add it to reach them)
#   AGENT_UI_GLYPHS=auto        (console dashboard glyphs; force unicode/ascii)
#   AGENT_TASK_NAME=FluxologyBrowserBridgeAgent   (only if -TaskName changed)
# =====================================================================

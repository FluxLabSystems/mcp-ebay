# Keycloak authorization-server environment — consumed by compose.auth.yaml.
# PLACEHOLDERS ONLY. Copy to deploy/auth/.env, fill in real values, then:
#   chmod 600 .env
# Never commit the real file. Run docker compose FROM deploy/auth/ so the
# ${...} substitutions in compose.auth.yaml read this same file.

# ---- Keycloak bootstrap admin (26.x KC_BOOTSTRAP_ADMIN_* pattern) ----
# Used ONLY on the first boot against an empty database, and the account it
# creates is TEMPORARY: after first login, create your own permanent admin
# user in the master realm and delete the temporary one (the admin console
# banners it until you do). Rotating these values later has no effect on an
# already-initialized database.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_BOOTSTRAP_ADMIN_PASSWORD

# ---- Public hostname ----
# Pins issuer, JWKS, admin-console and redirect URL construction. Must match
# the Caddy site block (caddy-auth-snippet.caddy) exactly. The https scheme
# here is what Keycloak advertises; TLS itself terminates at Caddy.
KC_HOSTNAME=https://auth.fluxology.ca

# ---- Keycloak's PostgreSQL (auth-db container bootstrap + KC_DB_* mapping) ----
# POSTGRES_* initialize the postgres:17-alpine container on first boot;
# compose.auth.yaml feeds the same values to Keycloak as KC_DB_USERNAME /
# KC_DB_PASSWORD / KC_DB_URL. Changing the password after the database
# volume exists requires changing it inside PostgreSQL too.
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=CHANGE_ME_AUTH_DB_PASSWORD
POSTGRES_DB=keycloak

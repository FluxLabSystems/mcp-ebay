# Site block for the EXISTING fluxology-caddy instance — auth.fluxology.ca.
# Add to the VPS-wide Caddyfile and validate/reload with the existing
# deployment method (docker exec <caddy> caddy validate / caddy reload).
# Do NOT overwrite the global Caddyfile and do NOT recreate the
# fluxology-caddy container. Do NOT paste a second auth.fluxology.ca block —
# Caddy rejects duplicate hostnames and takes every site down with it.
#
# Upstream: the Keycloak container from deploy/auth/compose.auth.yaml,
# reachable as fluxology-auth:8080 on the shared fluxology-edge network.
# Keycloak runs with --proxy-headers xforwarded and --http-enabled true and
# KC_HOSTNAME=https://auth.fluxology.ca, so it trusts exactly the
# X-Forwarded-* values set below and builds all its URLs (issuer, JWKS,
# admin console) against the public hostname.
#
# If the VPS Caddyfile already carries the (fluxology-defaults) snippet from
# fluxology-site docs/CADDY-INTEGRATION.md, replace the encode/header/log
# directives below with a single `import fluxology-defaults` line — they are
# copies of that snippet so this block also works standalone.

auth.fluxology.ca {
	encode zstd gzip

	header {
		# Caddy is the sole TLS terminator; it alone asserts HTTPS-only.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# The only per-request record for token and login traffic.
	log {
		output stdout
		format console
	}

	# Largest legitimate payload on this hostname is an admin-console partial
	# import upload; token/authorize requests are far below this. Write it as
	# MiB, not MB: Caddy reads `4MB` as 4000000.
	request_body {
		max_size 4MiB
	}

	reverse_proxy fluxology-auth:8080 {
		# Keycloak (--proxy-headers xforwarded) derives its public URLs and
		# secure-cookie behaviour from the X-Forwarded-* set. Caddy already
		# sends X-Forwarded-For, -Proto and -Host by default -- setting those
		# three explicitly makes `caddy validate` warn "Unnecessary header_up"
		# on every reload, which is noise that trains an operator to ignore
		# warnings. X-Forwarded-Port is NOT in Caddy's default set, so it is
		# the one that has to be sent here.
		header_up X-Forwarded-Port {port}

		# Readiness, on Keycloak's MANAGEMENT interface (:9000 — enabled by
		# KC_HEALTH_ENABLED=true in compose.auth.yaml). /health/ready fails
		# when the auth DB is unreachable; with no working database nothing
		# on this hostname can answer anyway, so unlike the mcp.fluxology.ca
		# block there is no bootstrap route worth keeping in rotation.
		health_uri /health/ready
		health_port 9000
		health_interval 30s
		health_timeout 5s
	}

	# --- RFC 8414 path-insertion discovery shim ---------------------------
	# RFC 8414 section 3.1 forms the metadata URL by INSERTING the well-known
	# path between the host and the issuer's path:
	#   /.well-known/oauth-authorization-server/realms/fluxology
	# Keycloak does not serve that shape. It serves the path-APPENDED forms:
	#   /realms/fluxology/.well-known/oauth-authorization-server
	#   /realms/fluxology/.well-known/openid-configuration
	# so the RFC-conformant URL 404s -- verified against Keycloak 26 on
	# 2026-08-25, which is what made lane-b-deploy.sh step [11] fail.
	#
	# An MCP client that only implements path-insertion (the MCP
	# authorization spec requires clients to try it) would give up there, so
	# this is on by default rather than optional: it costs one rewrite and
	# removes a whole class of client-side discovery failure.
	#
	# `rewrite` is ordered before `reverse_proxy`, so the matched request is
	# rewritten and then handled by the same upstream, headers and health
	# checks as everything else -- no `handle` wrapper, nothing duplicated.
	# The regexp anchors on a single realm segment, so a longer path is left
	# alone and reaches Keycloak untouched (it 404s there, correctly).
	#
	# Verified with `caddy validate` and against a live Caddy: the inserted
	# form (with and without a trailing slash) reaches
	# /realms/<realm>/.well-known/openid-configuration, while
	# /realms/..., /admin/... and every other path pass through unchanged.
	@rfc8414 path_regexp r8414 ^/\.well-known/oauth-authorization-server/realms/([^/]+)/?$
	rewrite @rfc8414 /realms/{re.r8414.1}/.well-known/openid-configuration
}
